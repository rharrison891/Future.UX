<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include=".\**\*_cg.cs" />
		<AdditionalFiles Include=".\**\*_cg.xaml" />
	</ItemGroup>
	<ItemGroup>
		<Compile Include=".\**\*_cg.cs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Future.UX.FluentIcons" Version="0.1.8" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Future.UX.SourceGenerators\Future.UX.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"  />
	</ItemGroup>
</Project>
