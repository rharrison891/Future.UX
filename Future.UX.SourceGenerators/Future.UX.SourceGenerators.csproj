<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>14</LangVersion>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<PackageId>Future.UX.SourceGenerators</PackageId>
		<Description>Source generator for bindable properties, commands, and fonts using __ fields and methods.</Description>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeSymbols>false</IncludeSymbols>
		<Version>1.0.1.3</Version>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Include="WpfElementProperties.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- Automatically apply the props to consumers -->
		<None Include="build\Future.UX.SourceGenerators.props" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" PrivateAssets="all" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.0" PrivateAssets="all" />
		<PackageReference Include="System.Text.Json" Version="10.0.0" />
	</ItemGroup>

	<!-- Include the generator DLL correctly -->
	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="build\" />
	</ItemGroup>

</Project>